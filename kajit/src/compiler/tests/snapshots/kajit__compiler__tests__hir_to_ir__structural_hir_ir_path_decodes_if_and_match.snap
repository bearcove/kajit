    n10 = WriteToSlot(2) [v4, %cs:n8] -> [%cs]
    n11 = ReadFromSlot(2) [%cs:n10] -> [v5, %cs]
    n16 = gamma [
      pred: v5
      in0: %cs:n11
      in1: %os:n8
      in2: %s2:n8
    ] {
      branch 0:
        region @s3 {
          args: [%cs, %os, %s2]
