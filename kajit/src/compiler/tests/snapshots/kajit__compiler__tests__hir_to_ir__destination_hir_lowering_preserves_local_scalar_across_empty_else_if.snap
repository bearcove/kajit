---
source: kajit/src/compiler/tests/hir_to_ir.rs
expression: "format!(\"{}\",\nir.display_with_registry(&crate::ir::IntrinsicRegistry::empty()))"
---
state_domains {
  d0 = output
  d1 = memory
}
scopes {
  s0 = lambda_body(@0)
  s1 = gamma_branch(0) parent s0
  s2 = gamma_branch(1) parent s0
}
lambda @0 @s0 (shape: "local_across_if", output_size: 4) {
  region @s0 {
    args: [arg0, %os, %ms]
    n1 = WriteToSlot(0) [arg0, %ms:arg] -> [%ms]
    n2 = Const(0x2) [] -> [v0]
    n3 = WriteToSlot(1) [v0, %ms:n1] -> [%ms]
    n4 = Const(0x0) [] -> [v1]
    n6 = gamma [
      pred: v1
      in0: %os:arg
      in1: %ms:n3
    ] {
      branch 0:
        region @s1 {
          args: [%os, %ms]
          results: [%os:arg, %ms:arg]
        }
      branch 1:
        region @s2 {
          args: [%os, %ms]
          n5 = ErrorExit(InvalidBool) [%ms:arg] -> []
          results: [%os:arg, %ms:arg]
        }
    } -> [%os, %ms]
    n7 = ReadFromSlot(1) [%ms:n6] -> [v2, %ms]
    n8 = Const(0x4) [] -> [v3]
    n9 = Or [v2, v3] -> [v4]
    n10 = WriteToSlot(1) [v4, %ms:n7] -> [%ms]
    n11 = ReadFromSlot(1) [%ms:n10] -> [v5, %ms]
    n12 = WriteToField(offset=0, W4) [v5, %os:n6] -> [%os]
    results: [%os:n12, %ms:n11]
  }
}
