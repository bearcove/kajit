---
source: kajit/src/compiler/tests/hir_to_ir.rs
expression: "format!(\"{}\",\nir.display_with_registry(&crate::ir::IntrinsicRegistry::empty()))"
---
state_domains {
  d0 = cursor
  d1 = output
  d2 = memory
}
scopes {
  s0 = lambda_body(@0)
}
lambda @0 @s0 (shape: "dynamic_aggregate_summary", output_size: 16) {
  region @s0 {
    args: [arg0, %cs, %os, %s2]
    n1 = WriteToSlot(0) [arg0, %cs:arg] -> [%cs]
    n2 = Const(0x1) [] -> [v0]
    n3 = WriteToSlot(1) [v0, %cs:n1] -> [%cs]
    n4 = Const(0x2) [] -> [v1]
    n5 = WriteToSlot(2) [v1, %cs:n3] -> [%cs]
    n6 = Const(0x3) [] -> [v2]
    n7 = WriteToSlot(3) [v2, %cs:n5] -> [%cs]
    n8 = Const(0x4) [] -> [v3]
    n9 = WriteToSlot(4) [v3, %cs:n7] -> [%cs]
    n10 = Const(0x1) [] -> [v4]
    n11 = WriteToSlot(5) [v4, %cs:n9] -> [%cs]
    n12 = ReadFromSlot(5) [%cs:n11] -> [v5, %cs]
    n13 = SlotAddr(1, n=4) [] -> [v6]
    n14 = Const(0x10) [] -> [v7]
    n15 = Mul [v5, v7] -> [v8]
    n16 = Add [v6, v8] -> [v9]
    n17 = LoadFromAddr(W8) [v9, %s2:arg] -> [v10, %s2]
    n18 = WriteToField(offset=0, W8) [v10, %os:arg] -> [%os]
    n19 = Const(0x8) [] -> [v11]
    n20 = Add [v9, v11] -> [v12]
    n21 = LoadFromAddr(W8) [v12, %s2:n17] -> [v13, %s2]
    n22 = WriteToField(offset=8, W8) [v13, %os:n18] -> [%os]
    results: [%cs:n12, %os:n22, %s2:n21]
  }
}
