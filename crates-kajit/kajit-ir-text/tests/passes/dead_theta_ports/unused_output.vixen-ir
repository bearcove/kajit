scopes {
  s0 = lambda_body(@0)
  s1 = theta_body parent s0
}
lambda @0 @s0 (shape: "test") {
  region @s0 {
    args: [%ms]
    n0 = Const(0x0) [] -> [v0]
    n1 = Const(0xa) [] -> [v1]
    n2 = theta(max=10) [v0, v1, %ms:arg] {
      region @s1 {
        args: [arg0, arg1, %ms]
        n3 = Const(0x1) [] -> [v2]
        n4 = Add [arg0, v2] -> [v3]
        n5 = Const(0xa) [] -> [v4]
        n6 = CmpEq [v3, v4] -> [v5]
        n7 = Add [arg1, v2] -> [v6]
        results: [v5, v3, v6, %ms:arg]
      }
    } -> [v7, v8, %ms]
    results: [%ms:n2]
  }
}
