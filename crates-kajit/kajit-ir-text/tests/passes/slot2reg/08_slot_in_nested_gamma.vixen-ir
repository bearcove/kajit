lambda @0 (shape: "test") {
  region {
    args: [%ms]
    n0 = Const(0x2a) [] -> [v0]
    n1 = WriteToSlot(0) [v0, %ms:arg] -> [%ms]
    n2 = Const(0x0) [] -> [v1]
    n9 = gamma [
      pred: v1
      in0: %ms:n1
    ] {
      branch 0:
        region {
          args: [%ms]
          n3 = Const(0x1) [] -> [v2]
          n8 = gamma [
            pred: v2
            in0: %ms:arg
          ] {
            branch 0:
              region {
                args: [%ms]
                n4 = ReadFromSlot(0) [%ms:arg] -> [v3, %ms]
                n5 = WriteToField(offset=0, W4) [v3, %ms:n4] -> [%ms]
                results: [%ms:n5]
              }
            branch 1:
              region {
                args: [%ms]
                n6 = ReadFromSlot(0) [%ms:arg] -> [v4, %ms]
                n7 = WriteToField(offset=0, W4) [v4, %ms:n6] -> [%ms]
                results: [%ms:n7]
              }
          } -> [%ms]
          results: [%ms:n8]
        }
      branch 1:
        region {
          args: [%ms]
          results: [%ms:arg]
        }
    } -> [%ms]
    results: [%ms:n9]
  }
}
