/// Human-facing representation name.
name IR

/// Canonical text file extension for IR documents.
file_ext .k-ir

/// High-level purpose of this representation.
description "Human-debuggable RVSDG IR with explicit regions, scopes, and canonical print round-trip."

/// Grammar rules for the current RVSDG IR text surface.
rules {
    templates {
        Keyword {
            syntax @template{
                params ({text @Any})
                body {
                    syntax text
                    highlight keyword
                }
            }
        }

        Operator {
            syntax @template{
                params ({text @Any})
                body {
                    syntax text
                    highlight operator
                }
            }
        }

        NumberToken {
            syntax @template{
                params ({inner @Any})
                body {
                    syntax inner
                    highlight number
                }
            }
        }
    }

    ScopesKw @Keyword("scopes")
    LambdaKw @Keyword("lambda")
    RegionKw @Keyword("region")
    ArgsKw @Keyword("args")
    ResultsKw @Keyword("results")
    PredKw @Keyword("pred")
    BranchKw @Keyword("branch")
    GammaKw @Keyword("gamma")
    ThetaKw @Keyword("theta")
    ApplyKw @Keyword("apply")
    LambdaBodyKw @Keyword("lambda_body")
    GammaBranchKw @Keyword("gamma_branch")
    ThetaBodyKw @Keyword("theta_body")
    SyntheticKw @Keyword("synthetic")
    ShapeKw @Keyword("shape")
    OutputSizeKw @Keyword("output_size")
    ParentKw @Keyword("parent")
    InKw @Keyword("in")
    MaxKw @Keyword("max")
    BlobIdKw @Keyword("blob_id")
    FromKw @Keyword("from")
    StackAllocKw @Keyword("StackAlloc")
    StoreToAddrKw @Keyword("StoreToAddr")
    LoadFromAddrKw @Keyword("LoadFromAddr")
    DataAddrKw @Keyword("DataAddr")
    ConstKw @Keyword("Const")
    ExternAddrKw @Keyword("ExternAddr")
    AddKw @Keyword("Add")
    SubKw @Keyword("Sub")
    MulKw @Keyword("Mul")
    AndKw @Keyword("And")
    OrKw @Keyword("Or")
    ShrKw @Keyword("Shr")
    ShlKw @Keyword("Shl")
    SarKw @Keyword("Sar")
    XorKw @Keyword("Xor")
    CmpEqKw @Keyword("CmpEq")
    CmpNeKw @Keyword("CmpNe")
    CmpLtKw @Keyword("CmpLt")
    CmpLeKw @Keyword("CmpLe")
    CmpGtKw @Keyword("CmpGt")
    CmpGeKw @Keyword("CmpGe")
    SignExtendKw @Keyword("SignExtend")
    CallIntrinsicKw @Keyword("CallIntrinsic")
    CallPureKw @Keyword("CallPure")
    CallEffectKw @Keyword("CallEffect")
    NopKw @Keyword("Nop")
    IdentityKw @Keyword("Identity")
    W1Kw @Keyword("W1")
    W2Kw @Keyword("W2")
    W4Kw @Keyword("W4")
    W8Kw @Keyword("W8")

    LBrace @Operator("{")
    RBrace @Operator("}")
    LBracket @Operator("[")
    RBracket @Operator("]")
    LParen @Operator("(")
    RParen @Operator(")")
    Colon @Operator(":")
    Comma @Operator(",")
    Equals @Operator("=")
    Arrow @Operator("->")
    At @Operator("@")
    Dot @Operator(".")

    Ident {
        syntax @regex("[A-Za-z0-9_:.]+")
    }

    QuotedString {
        syntax @regex("\"[^\"]*\"")
    }

    Nat @NumberToken(@regex("0x[0-9A-Fa-f]+|[0-9]+"))

    Symbol @struct{
        syntax ({name @Ident})
    }

    ScopeId @struct{
        syntax ("s" {index @Nat})
    }

    LambdaId @struct{
        syntax (@At {index @Nat})
    }

    NodeId @struct{
        syntax ("n" {index @Nat})
    }

    VReg @struct{
        syntax ("v" {index @Nat})
    }

    Width @enum
    Width.W1 @struct{ syntax (@W1Kw) }
    Width.W2 @struct{ syntax (@W2Kw) }
    Width.W4 @struct{ syntax (@W4Kw) }
    Width.W8 @struct{ syntax (@W8Kw) }

    StateDomain @enum
    StateDomain.Memory @struct{
        syntax ("%ms")
    }
    StateDomain.Named @struct{
        syntax ("%s" {index @Nat})
    }

    Program @struct{
        syntax (
            @optional({scopes @ScopeBlock} @newline)
            {lambdas @many(@Lambda @newline)}
        )
    }

    ScopeBlock @struct{
        syntax @brace_block(
            prefix (@ScopesKw @soft_space)
            body {scopes @many(@DebugScope @newline)}
        )
    }

    DebugScope @enum

    DebugScope.LambdaBody @struct{
        syntax (
            {id @ScopeId}
            @soft_space
            @Equals
            @soft_space
            @LambdaBodyKw
            {lambda_id @paren(@LambdaId)}
            @optional(
                @soft_space
                @ParentKw
                @soft_space
                {parent @ScopeId}
            )
        )
    }

    DebugScope.GammaBranch @struct{
        syntax (
            {id @ScopeId}
            @soft_space
            @Equals
            @soft_space
            @GammaBranchKw
            {branch_index @paren(@Nat)}
            @optional(
                @soft_space
                @ParentKw
                @soft_space
                {parent @ScopeId}
            )
        )
    }

    DebugScope.ThetaBody @struct{
        syntax (
            {id @ScopeId}
            @soft_space
            @Equals
            @soft_space
            @ThetaBodyKw
            @optional(
                @soft_space
                @ParentKw
                @soft_space
                {parent @ScopeId}
            )
        )
    }

    DebugScope.Synthetic @struct{
        syntax (
            {id @ScopeId}
            @soft_space
            @Equals
            @soft_space
            @SyntheticKw
            @optional(
                @soft_space
                @ParentKw
                @soft_space
                {parent @ScopeId}
            )
        )
    }

    Lambda @struct{
        syntax @brace_block(
            prefix (
                @LambdaKw
                @soft_space
                {id @LambdaId}
                @soft_space
                {scope @ScopeId}
                @soft_space
                {shape @LambdaShape}
                @optional(
                    @Comma
                    @soft_space
                    @OutputSizeKw
                    @Colon
                    @soft_space
                    {output_size @Nat}
                )
                @soft_space
            )
            body ({body @Region})
        )
    }

    LambdaShape @struct{
        syntax (
            @LParen
            @ShapeKw
            @Colon
            @soft_space
            {label @QuotedString}
            @RParen
        )
    }

    Region @struct{
        syntax @brace_block(
            prefix (
                @RegionKw
                @soft_space
                {scope @ScopeId}
                @soft_space
            )
            body (
                {args @RegionArgsLine}
                @newline
                {nodes @many(@Node @newline)}
                {results @RegionResultsLine}
            )
        )
    }

    RegionArgsLine @struct{
        syntax (
            @ArgsKw
            @Colon
            @soft_space
            {args @bracket_list(@RegionArg ",")}
        )
    }

    RegionResultsLine @struct{
        syntax (
            @ResultsKw
            @Colon
            @soft_space
            {results @bracket_list(@PortSource ",")}
        )
    }

    RegionArg @enum

    RegionArg.Data @struct{
        syntax ("arg" {index @Nat})
    }

    RegionArg.State @struct{
        syntax ({domain @StateDomain})
    }

    PortSource @enum

    PortSource.VReg @struct{
        syntax ({vreg @VReg})
    }

    PortSource.StateNode @struct{
        syntax (
            {domain @StateDomain}
            @Colon
            {node @NodeId}
        )
    }

    PortSource.StateArg @struct{
        syntax (
            {domain @StateDomain}
            @Colon
            "arg"
        )
    }

    PortSource.QualifiedRegionArg @struct{
        syntax (
            @At
            {scope @ScopeId}
            @Dot
            "arg"
            {arg_index @Nat}
        )
    }

    PortSource.QualifiedStateArg @struct{
        syntax (
            {domain @StateDomain}
            @Colon
            @At
            {scope @ScopeId}
            @Dot
            "arg"
        )
    }

    PortSource.NodeOutput @struct{
        syntax (
            {node @NodeId}
            @Dot
            {index @Nat}
        )
    }

    ScopedOutput @enum

    ScopedOutput.VReg @struct{
        syntax (
            {vreg @VReg}
            @optional({scope @ScopeId})
        )
    }

    ScopedOutput.State @struct{
        syntax (
            "%ms"
            @optional({scope @ScopeId})
        )
    }

    ScopedOutput.Unknown @struct{
        syntax (
            "?"
            @optional({scope @ScopeId})
        )
    }

    Node @enum

    Node.Simple @struct{
        syntax (
            {id @NodeId}
            @optional(
                @soft_space
                {scope @ScopeId}
            )
            @soft_space
            @Equals
            @soft_space
            {op @IrOp}
            @soft_space
            {inputs @bracket_list(@PortSource ",")}
            @soft_space
            @Arrow
            @soft_space
            {outputs @bracket_list(@ScopedOutput ",")}
        )
    }

    Node.Gamma @struct{
        syntax (
            {id @NodeId}
            @optional(
                @soft_space
                {scope @ScopeId}
            )
            @soft_space
            @Equals
            @soft_space
            @GammaKw
            @soft_space
            @LBracket
            @newline
            @indent(
                @PredKw
                @Colon
                @soft_space
                {pred @PortSource}
                @newline
                {extra_inputs @many(@GammaInputLine @newline)}
            )
            @RBracket
            @soft_space
            @brace_block(
                body {branches @many(@GammaBranch @newline)}
            )
            @soft_space
            @Arrow
            @soft_space
            {outputs @bracket_list(@ScopedOutput ",")}
        )
    }

    GammaInputLine @struct{
        syntax (
            @InKw
            {index @Nat}
            @Colon
            @soft_space
            {source @PortSource}
        )
    }

    GammaBranch @struct{
        syntax (
            @BranchKw
            @soft_space
            {index @Nat}
            @Colon
            @newline
            @indent({body @Region})
        )
    }

    Node.Theta @struct{
        syntax (
            {id @NodeId}
            @optional(
                @soft_space
                {scope @ScopeId}
            )
            @soft_space
            @Equals
            @soft_space
            @ThetaKw
            @optional(
                @LParen
                @MaxKw
                @Equals
                {max_iterations @Nat}
                @RParen
            )
            @soft_space
            {inputs @bracket_list(@PortSource ",")}
            @soft_space
            @brace_block(
                body ({body @Region})
            )
            @soft_space
            @Arrow
            @soft_space
            {outputs @bracket_list(@ScopedOutput ",")}
        )
    }

    Node.Apply @struct{
        syntax (
            {id @NodeId}
            @optional(
                @soft_space
                {scope @ScopeId}
            )
            @soft_space
            @Equals
            @soft_space
            @ApplyKw
            @soft_space
            {target @LambdaId}
            @soft_space
            {inputs @bracket_list(@PortSource ",")}
            @soft_space
            @Arrow
            @soft_space
            {outputs @bracket_list(@ScopedOutput ",")}
        )
    }

    IrOp @enum

    IrOp.StackAlloc @struct{
        syntax (
            @StackAllocKw
            {id @paren(@Nat)}
        )
    }

    IrOp.StoreToAddr @struct{
        syntax (
            @StoreToAddrKw
            {width @paren(@Width)}
        )
    }

    IrOp.LoadFromAddr @struct{
        syntax (
            @LoadFromAddrKw
            {width @paren(@Width)}
        )
    }

    IrOp.DataAddr @struct{
        syntax (
            @DataAddrKw
            @LParen
            @BlobIdKw
            @Equals
            {blob_id @Nat}
            @RParen
        )
    }

    IrOp.Const @struct{
        syntax (
            @ConstKw
            {value @paren(@ConstRef)}
        )
    }

    IrOp.ExternAddr @struct{
        syntax (
            @ExternAddrKw
            @LParen
            @At
            {symbol @Symbol}
            @RParen
        )
    }

    IrOp.CallIntrinsic @struct{
        syntax (
            @CallIntrinsicKw
            {func @paren(@IntrinsicRef)}
        )
    }

    IrOp.CallPure @struct{
        syntax (
            @CallPureKw
            {func @paren(@IntrinsicRef)}
        )
    }

    IrOp.CallEffect @struct{
        syntax (
            @CallEffectKw
            {func @paren(@IntrinsicRef)}
        )
    }

    IrOp.SignExtend @struct{
        syntax (
            @SignExtendKw
            @LParen
            @FromKw
            @Equals
            {from_width @Width}
            @RParen
        )
    }

    IrOp.Add @struct{ syntax (@AddKw) }
    IrOp.Sub @struct{ syntax (@SubKw) }
    IrOp.Mul @struct{ syntax (@MulKw) }
    IrOp.And @struct{ syntax (@AndKw) }
    IrOp.Or @struct{ syntax (@OrKw) }
    IrOp.Shr @struct{ syntax (@ShrKw) }
    IrOp.Shl @struct{ syntax (@ShlKw) }
    IrOp.Sar @struct{ syntax (@SarKw) }
    IrOp.Xor @struct{ syntax (@XorKw) }
    IrOp.CmpEq @struct{ syntax (@CmpEqKw) }
    IrOp.CmpNe @struct{ syntax (@CmpNeKw) }
    IrOp.CmpLt @struct{ syntax (@CmpLtKw) }
    IrOp.CmpLe @struct{ syntax (@CmpLeKw) }
    IrOp.CmpGt @struct{ syntax (@CmpGtKw) }
    IrOp.CmpGe @struct{ syntax (@CmpGeKw) }
    IrOp.Nop @struct{ syntax (@NopKw) }
    IrOp.Identity @struct{ syntax (@IdentityKw) }

    ConstRef @enum

    ConstRef.Named @struct{
        syntax (
            @At
            {name @Symbol}
        )
    }

    ConstRef.Value @struct{
        syntax ({value @Nat})
    }

    IntrinsicRef @enum

    IntrinsicRef.Named @struct{
        syntax (
            @At
            {name @Symbol}
        )
    }

    IntrinsicRef.Address @struct{
        syntax ({value @Nat})
    }
}
