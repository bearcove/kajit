/// Human-facing representation name.
name MIR

/// Canonical text file extension for MIR documents.
file_ext .k-mir

/// High-level purpose of this representation.
description "Canonical executable CFG IR with canonical print round-trip and required provenance."

/// Grammar rules for the canonical CFG-MIR subset.
rules {
    keyword @group{
        CfgProgramKw "cfg_program"
        CfgFuncKw "cfg_func"
        DataArgsKw "data_args"
        DataResultsKw "data_results"
        BlockKw "block"
        EdgeKw "edge"
        InstKw "inst"
        TermKw "term"
        ReturnKw "return"
        BranchKw "branch"
        BranchIfKw "branch_if"
        BranchIfZeroKw "branch_if_zero"
        JumpTableKw "jump_table"
        FallthroughKw "fallthrough"
        CopyKw "copy"
        ConstKw "const"
        DataAddrKw "data_addr"
        ExternAddrKw "extern_addr"
        StackAllocKw "stack_alloc"
        StoreAddrKw "store_addr"
        LoadAddrKw "load_addr"
        WriteSlotKw "write_slot"
        ReadSlotKw "read_slot"
        CallIntrinsicKw "call_intrinsic"
        CallPureKw "call_pure"
        CallEffectKw "call_effect"
        CallLambdaKw "call_lambda"
        SignExtendKw "SignExtend"
        AbiArgKw "arg"
        AbiRetKw "ret"
        HwKw "hw"
        GprKw "gpr"
        SimdKw "simd"
        BothKw "both"
        AddKw "add"
        SubKw "sub"
        MulKw "mul"
        AndKw "and"
        OrKw "or"
        SarKw "sar"
        ShrKw "shr"
        ShlKw "shl"
        XorKw "xor"
        CmpEqKw "cmpeq"
        CmpNeKw "cmpne"
        CmpLtKw "cmplt"
        CmpLeKw "cmple"
        CmpGtKw "cmpgt"
        CmpGeKw "cmpge"
        W1Kw "w1"
        W2Kw "w2"
        W4Kw "w4"
        W8Kw "w8"
    }

    operator @group{
        LBrace "{"
        RBrace "}"
        LBracket "["
        RBracket "]"
        LParen "("
        RParen ")"
        Colon ":"
        Comma ","
        Arrow "->"
        Equals "="
        Bang "!"
        Slash "/"
        At "@"
    }

    Ident {
        syntax @regex("[A-Za-z_][A-Za-z0-9_]*")
    }

    number @group{
        Nat {
            syntax @regex("[0-9]+")
        }
    }

    Symbol @struct{
        syntax ({name @Ident})
    }

    VReg @struct{
        syntax ("v" {index @Nat})
    }

    FunctionId @struct{
        syntax ("f" {index @Nat})
    }

    LambdaId @struct{
        syntax (@At {index @Nat})
    }

    BlockId @struct{
        syntax ("b" {index @Nat})
    }

    EdgeId @struct{
        syntax ("e" {index @Nat})
    }

    InstId @struct{
        syntax ("i" {index @Nat})
    }

    TermId @struct{
        syntax ("t" {index @Nat})
    }

    SlotId @struct{
        syntax ({index @Nat})
    }

    StackAllocId @struct{
        syntax ({index @Nat})
    }

    BlobId @struct{
        syntax ({index @Nat})
    }

    Width @enum
    Width.W1 @struct{ syntax (@W1Kw) }
    Width.W2 @struct{ syntax (@W2Kw) }
    Width.W4 @struct{ syntax (@W4Kw) }
    Width.W8 @struct{ syntax (@W8Kw) }

    RegClass @enum
    RegClass.Gpr @struct{ syntax (@GprKw) }
    RegClass.Simd @struct{ syntax (@SimdKw) }

    ClobberKind @enum
    ClobberKind.Gpr @struct{ syntax (@GprKw) }
    ClobberKind.Simd @struct{ syntax (@SimdKw) }
    ClobberKind.Both @struct{ syntax (@BothKw) }

    BinOpKind @enum
    BinOpKind.Add @struct{ syntax (@AddKw) }
    BinOpKind.Sub @struct{ syntax (@SubKw) }
    BinOpKind.Mul @struct{ syntax (@MulKw) }
    BinOpKind.And @struct{ syntax (@AndKw) }
    BinOpKind.Or @struct{ syntax (@OrKw) }
    BinOpKind.Sar @struct{ syntax (@SarKw) }
    BinOpKind.Shr @struct{ syntax (@ShrKw) }
    BinOpKind.Shl @struct{ syntax (@ShlKw) }
    BinOpKind.Xor @struct{ syntax (@XorKw) }
    BinOpKind.CmpEq @struct{ syntax (@CmpEqKw) }
    BinOpKind.CmpNe @struct{ syntax (@CmpNeKw) }
    BinOpKind.CmpLt @struct{ syntax (@CmpLtKw) }
    BinOpKind.CmpLe @struct{ syntax (@CmpLeKw) }
    BinOpKind.CmpGt @struct{ syntax (@CmpGtKw) }
    BinOpKind.CmpGe @struct{ syntax (@CmpGeKw) }

    Program @struct{
        syntax @brace_block(
            prefix (
                @CfgProgramKw
                @soft_space
                "vregs="
                {vreg_count @Nat}
                @soft_space
                "slots="
                {slot_count @Nat}
                @soft_space
            )
            body {functions @many(@Function @newline)}
        )
    }

    Function @struct{
        syntax @brace_block(
            prefix (
                @CfgFuncKw
                @soft_space
                {lambda_id @LambdaId}
                @soft_space
                {function_id @FunctionId}
                @soft_space
                "entry="
                {entry @BlockId}
                @soft_space
            )
            body (
                {data_args @DataArgsLine}
                @newline
                {data_results @DataResultsLine}
                @newline
                {blocks @many(@Block @newline)}
                {insts @many(@Inst @newline)}
                {terms @many(@Terminator @newline)}
                {edges @many(@Edge @newline)}
            )
        )
    }

    DataArgsLine @struct{
        syntax (
            @DataArgsKw
            @Colon
            @soft_space
            {args @bracket_list(@VReg ",")}
        )
    }

    DataResultsLine @struct{
        syntax (
            @DataResultsKw
            @Colon
            @soft_space
            {results @bracket_list(@VReg ",")}
        )
    }

    Block @struct{
        syntax (
            @BlockKw
            @soft_space
            {id @BlockId}
            @soft_space
            "params="
            {params @bracket_list(@VReg ",")}
            @soft_space
            "insts="
            {insts @bracket_list(@InstId ",")}
            @soft_space
            "term="
            {term @TermId}
            @soft_space
            "preds="
            {preds @bracket_list(@EdgeId ",")}
            @soft_space
            "succs="
            {succs @bracket_list(@EdgeId ",")}
        )
    }

    EdgeArg @enum

    EdgeArg.Identity @struct{
        syntax ({vreg @VReg})
    }

    EdgeArg.Mapped @struct{
        syntax (
            {target @VReg}
            "=>"
            {source @VReg}
        )
    }

    Edge @struct{
        syntax (
            @EdgeKw
            @soft_space
            {id @EdgeId}
            @Colon
            @soft_space
            {from @BlockId}
            @soft_space
            @Arrow
            @soft_space
            {to @BlockId}
            @soft_space
            {args @bracket_list(@EdgeArg ",")}
        )
    }

    FixedReg @enum

    FixedReg.AbiArg @struct{
        syntax (
            @AbiArgKw
            {index @Nat}
        )
    }

    FixedReg.AbiRet @struct{
        syntax (
            @AbiRetKw
            {index @Nat}
        )
    }

    FixedReg.HwReg @struct{
        syntax (
            @HwKw
            {index @Nat}
        )
    }

    Operand @struct{
        syntax (
            {vreg @VReg}
            @Colon
            {class @RegClass}
            @optional(
                @Slash
                {fixed @FixedReg}
            )
        )
    }

    ConstRef @enum

    ConstRef.Named @struct{
        syntax (
            @At
            {name @Symbol}
        )
    }

    ConstRef.Value @struct{
        syntax ({value @Nat})
    }

    IntrinsicRef @enum

    IntrinsicRef.Named @struct{
        syntax (
            @At
            {name @Symbol}
        )
    }

    IntrinsicRef.Address @struct{
        syntax ({value @Nat})
    }

    UnaryOp @enum

    UnaryOp.SignExtend @struct{
        syntax (
            @SignExtendKw
            @soft_space
            @brace_block(
                body (
                    "from_width:"
                    @soft_space
                    {from_width @Width}
                )
            )
        )
    }

    InstOp @enum

    InstOp.Const @struct{
        syntax (
            @ConstKw
            {value @paren(@ConstRef)}
        )
    }

    InstOp.DataAddr @struct{
        syntax (
            @DataAddrKw
            {blob_id @paren(@BlobId)}
        )
    }

    InstOp.ExternAddr @struct{
        syntax (
            @ExternAddrKw
            {symbol @paren(@IntrinsicRef)}
        )
    }

    InstOp.BinOp @struct{
        syntax ({op @BinOpKind})
    }

    InstOp.UnaryOp @struct{
        syntax ({op @UnaryOp})
    }

    InstOp.Copy @struct{
        syntax (@CopyKw)
    }

    InstOp.StackAlloc @struct{
        syntax (
            @StackAllocKw
            {id @paren(@StackAllocId)}
        )
    }

    InstOp.StoreToAddr @struct{
        syntax (
            @StoreAddrKw
            {width @paren(@bracket(@Width))}
        )
    }

    InstOp.LoadFromAddr @struct{
        syntax (
            @LoadAddrKw
            {width @paren(@bracket(@Width))}
        )
    }

    InstOp.WriteToSlot @struct{
        syntax (
            @WriteSlotKw
            {slot @paren(@SlotId)}
        )
    }

    InstOp.ReadFromSlot @struct{
        syntax (
            @ReadSlotKw
            {slot @paren(@SlotId)}
        )
    }

    InstOp.CallIntrinsic @struct{
        syntax (
            @CallIntrinsicKw
            {func @paren(@IntrinsicRef)}
        )
    }

    InstOp.CallPure @struct{
        syntax (
            @CallPureKw
            {func @paren(@IntrinsicRef)}
        )
    }

    InstOp.CallEffect @struct{
        syntax (
            @CallEffectKw
            {func @paren(@IntrinsicRef)}
        )
    }

    InstOp.CallLambda @struct{
        syntax (
            @CallLambdaKw
            {target @paren(@LambdaId)}
        )
    }

    Inst @struct{
        syntax (
            @InstKw
            @soft_space
            {id @InstId}
            @Colon
            @optional(
                @soft_space
                {defs @separated_by(@Operand ",")}
                @soft_space
                @Equals
            )
            @soft_space
            {op @InstOp}
            @optional(
                @soft_space
                {uses @separated_by(@Operand ",")}
            )
            @optional(
                @Bang
                {clobbers @ClobberKind}
            )
        )
    }

    Terminator @enum

    Terminator.Return @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @ReturnKw
        )
    }

    Terminator.Branch @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @BranchKw
            @soft_space
            {edge @EdgeId}
        )
    }

    Terminator.BranchIf @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @BranchIfKw
            @soft_space
            {cond @VReg}
            @soft_space
            @Arrow
            @soft_space
            {taken @EdgeId}
            @Comma
            @soft_space
            @FallthroughKw
            @soft_space
            {fallthrough @EdgeId}
        )
    }

    Terminator.BranchIfZero @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @BranchIfZeroKw
            @soft_space
            {cond @VReg}
            @soft_space
            @Arrow
            @soft_space
            {taken @EdgeId}
            @Comma
            @soft_space
            @FallthroughKw
            @soft_space
            {fallthrough @EdgeId}
        )
    }

    Terminator.JumpTable @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @JumpTableKw
            @soft_space
            {predicate @VReg}
            @soft_space
            {targets @bracket_list(@EdgeId ",")}
            @Comma
            @soft_space
            "default"
            @soft_space
            {default @EdgeId}
        )
    }
}
