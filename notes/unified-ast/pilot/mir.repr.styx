/// Human-facing representation name.
name MIR

/// Canonical text file extension for MIR documents.
file_ext .k-mir

/// High-level purpose of this representation.
description "Canonical executable CFG IR with canonical print round-trip and required provenance."

/// Grammar rules for the canonical CFG-MIR subset.
rules {
    templates {
        Keyword {
            syntax @template{
                params ({text @Any})
                body {
                    syntax text
                    highlight keyword
                }
            }
        }

        Operator {
            syntax @template{
                params ({text @Any})
                body {
                    syntax text
                    highlight operator
                }
            }
        }

        NumberToken {
            syntax @template{
                params ({inner @Any})
                body {
                    syntax inner
                    highlight number
                }
            }
        }
    }

    CfgProgramKw @Keyword("cfg_program")
    CfgFuncKw @Keyword("cfg_func")
    DataArgsKw @Keyword("data_args")
    DataResultsKw @Keyword("data_results")
    BlockKw @Keyword("block")
    EdgeKw @Keyword("edge")
    InstKw @Keyword("inst")
    TermKw @Keyword("term")
    ReturnKw @Keyword("return")
    BranchKw @Keyword("branch")
    BranchIfKw @Keyword("branch_if")
    BranchIfZeroKw @Keyword("branch_if_zero")
    JumpTableKw @Keyword("jump_table")
    FallthroughKw @Keyword("fallthrough")
    CopyKw @Keyword("copy")
    ConstKw @Keyword("const")
    DataAddrKw @Keyword("data_addr")
    ExternAddrKw @Keyword("extern_addr")
    SlotAddrKw @Keyword("slot_addr")
    StackAllocKw @Keyword("stack_alloc")
    StoreAddrKw @Keyword("store_addr")
    LoadAddrKw @Keyword("load_addr")
    WriteSlotKw @Keyword("write_slot")
    ReadSlotKw @Keyword("read_slot")
    CallIntrinsicKw @Keyword("call_intrinsic")
    CallPureKw @Keyword("call_pure")
    CallEffectKw @Keyword("call_effect")
    CallLambdaKw @Keyword("call_lambda")
    SignExtendKw @Keyword("SignExtend")
    AbiArgKw @Keyword("arg")
    AbiRetKw @Keyword("ret")
    HwKw @Keyword("hw")
    GprKw @Keyword("gpr")
    SimdKw @Keyword("simd")
    AddKw @Keyword("Add")
    SubKw @Keyword("Sub")
    MulKw @Keyword("Mul")
    AndKw @Keyword("And")
    OrKw @Keyword("Or")
    SarKw @Keyword("Sar")
    ShrKw @Keyword("Shr")
    ShlKw @Keyword("Shl")
    XorKw @Keyword("Xor")
    CmpEqKw @Keyword("CmpEq")
    CmpNeKw @Keyword("CmpNe")
    CmpLtKw @Keyword("CmpLt")
    CmpLeKw @Keyword("CmpLe")
    CmpGtKw @Keyword("CmpGt")
    CmpGeKw @Keyword("CmpGe")
    W1Kw @Keyword("W1")
    W2Kw @Keyword("W2")
    W4Kw @Keyword("W4")
    W8Kw @Keyword("W8")

    LBrace @Operator("{")
    RBrace @Operator("}")
    LBracket @Operator("[")
    RBracket @Operator("]")
    LParen @Operator("(")
    RParen @Operator(")")
    Colon @Operator(":")
    Comma @Operator(",")
    Arrow @Operator("->")
    Equals @Operator("=")
    Bang @Operator("!")
    Slash @Operator("/")
    At @Operator("@")

    Ident {
        syntax @regex("[A-Za-z0-9_:.]+")
    }

    Nat @NumberToken(@regex("0x[0-9A-Fa-f]+|[0-9]+"))

    Symbol @struct{
        syntax ({name @Ident})
    }

    VReg @struct{
        syntax ("v" {index @Nat})
    }

    FunctionId @struct{
        syntax ("f" {index @Nat})
    }

    LambdaId @struct{
        syntax (@At {index @Nat})
    }

    BlockId @struct{
        syntax ("b" {index @Nat})
    }

    EdgeId @struct{
        syntax ("e" {index @Nat})
    }

    InstId @struct{
        syntax ("i" {index @Nat})
    }

    TermId @struct{
        syntax ("t" {index @Nat})
    }

    SlotId @struct{
        syntax ({index @Nat})
    }

    StackAllocId @struct{
        syntax ({index @Nat})
    }

    BlobId @struct{
        syntax ({index @Nat})
    }

    Width @enum
    Width.W1 @struct{ syntax (@W1Kw) }
    Width.W2 @struct{ syntax (@W2Kw) }
    Width.W4 @struct{ syntax (@W4Kw) }
    Width.W8 @struct{ syntax (@W8Kw) }

    RegClass @enum
    RegClass.Gpr @struct{ syntax (@GprKw) }
    RegClass.Simd @struct{ syntax (@SimdKw) }

    ClobberKind @enum
    ClobberKind.Gpr @struct{ syntax (@GprKw) }
    ClobberKind.Simd @struct{ syntax (@SimdKw) }
    ClobberKind.Both @struct{
        syntax (
            @GprKw
            @Comma
            @SimdKw
        )
    }

    BinOpKind @enum
    BinOpKind.Add @struct{ syntax (@AddKw) }
    BinOpKind.Sub @struct{ syntax (@SubKw) }
    BinOpKind.Mul @struct{ syntax (@MulKw) }
    BinOpKind.And @struct{ syntax (@AndKw) }
    BinOpKind.Or @struct{ syntax (@OrKw) }
    BinOpKind.Sar @struct{ syntax (@SarKw) }
    BinOpKind.Shr @struct{ syntax (@ShrKw) }
    BinOpKind.Shl @struct{ syntax (@ShlKw) }
    BinOpKind.Xor @struct{ syntax (@XorKw) }
    BinOpKind.CmpEq @struct{ syntax (@CmpEqKw) }
    BinOpKind.CmpNe @struct{ syntax (@CmpNeKw) }
    BinOpKind.CmpLt @struct{ syntax (@CmpLtKw) }
    BinOpKind.CmpLe @struct{ syntax (@CmpLeKw) }
    BinOpKind.CmpGt @struct{ syntax (@CmpGtKw) }
    BinOpKind.CmpGe @struct{ syntax (@CmpGeKw) }

    Program @struct{
        syntax @brace_block(
            prefix (
                @CfgProgramKw
                @soft_space
                "vregs="
                {vreg_count @Nat}
                @soft_space
                "slots="
                {slot_count @Nat}
                @soft_space
            )
            body {functions @many(@Function @newline)}
        )
    }

    Function @struct{
        syntax @brace_block(
            prefix (
                @CfgFuncKw
                @soft_space
                {lambda_id @LambdaId}
                @soft_space
                {function_id @FunctionId}
                @soft_space
                "entry="
                {entry @BlockId}
                @soft_space
            )
            body (
                {data_args @DataArgsLine}
                @newline
                {data_results @DataResultsLine}
                @newline
                {blocks @many(@Block @newline)}
                {insts @many(@Inst @newline)}
                {terms @many(@Terminator @newline)}
                {edges @many(@Edge @newline)}
            )
        )
    }

    DataArgsLine @struct{
        syntax (
            @DataArgsKw
            @Colon
            @soft_space
            {args @bracket_list(@VReg ",")}
        )
    }

    DataResultsLine @struct{
        syntax (
            @DataResultsKw
            @Colon
            @soft_space
            {results @bracket_list(@VReg ",")}
        )
    }

    Block @struct{
        syntax (
            @BlockKw
            @soft_space
            {id @BlockId}
            @soft_space
            "params="
            {params @bracket_list(@VReg ",")}
            @soft_space
            "insts="
            {insts @bracket_list(@InstId ",")}
            @soft_space
            "term="
            {term @TermId}
            @soft_space
            "preds="
            {preds @bracket_list(@EdgeId ",")}
            @soft_space
            "succs="
            {succs @bracket_list(@EdgeId ",")}
        )
    }

    EdgeArg @enum

    EdgeArg.Identity @struct{
        syntax ({vreg @VReg})
    }

    EdgeArg.Mapped @struct{
        syntax (
            {target @VReg}
            "=>"
            {source @VReg}
        )
    }

    Edge @struct{
        syntax (
            @EdgeKw
            @soft_space
            {id @EdgeId}
            @Colon
            @soft_space
            {from @BlockId}
            @soft_space
            @Arrow
            @soft_space
            {to @BlockId}
            @soft_space
            {args @bracket_list(@EdgeArg ",")}
        )
    }

    FixedReg @enum

    FixedReg.AbiArg @struct{
        syntax (
            @AbiArgKw
            {index @Nat}
        )
    }

    FixedReg.AbiRet @struct{
        syntax (
            @AbiRetKw
            {index @Nat}
        )
    }

    FixedReg.HwReg @struct{
        syntax (
            @HwKw
            {index @Nat}
        )
    }

    Operand @struct{
        syntax (
            {vreg @VReg}
            @Colon
            {class @RegClass}
            @optional(
                @Slash
                {fixed @FixedReg}
            )
        )
    }

    ConstRef @enum

    ConstRef.Named @struct{
        syntax (
            @At
            {name @Symbol}
        )
    }

    ConstRef.Value @struct{
        syntax ({value @Nat})
    }

    IntrinsicRef @enum

    IntrinsicRef.Named @struct{
        syntax (
            @At
            {name @Symbol}
        )
    }

    IntrinsicRef.Address @struct{
        syntax ({value @Nat})
    }

    UnaryOp @enum

    UnaryOp.SignExtend @struct{
        syntax (
            @SignExtendKw
            @soft_space
            @brace_block(
                body (
                    "from_width:"
                    @soft_space
                    {from_width @Width}
                )
            )
        )
    }

    InstOp @enum

    InstOp.Const @struct{
        syntax (
            @ConstKw
            {value @paren(@ConstRef)}
        )
    }

    InstOp.DataAddr @struct{
        syntax (
            @DataAddrKw
            {blob_id @paren(@BlobId)}
        )
    }

    InstOp.ExternAddr @struct{
        syntax (
            @ExternAddrKw
            {symbol @paren(@IntrinsicRef)}
        )
    }

    InstOp.BinOp @struct{
        syntax ({op @BinOpKind})
    }

    InstOp.UnaryOp @struct{
        syntax ({op @UnaryOp})
    }

    InstOp.Copy @struct{
        syntax (@CopyKw)
    }

    InstOp.StackAlloc @struct{
        syntax (
            @StackAllocKw
            {id @paren(@StackAllocId)}
        )
    }

    InstOp.SlotAddr @struct{
        syntax (
            @SlotAddrKw
            {slot @paren(@SlotId)}
        )
    }

    InstOp.StoreToAddr @struct{
        syntax (
            @StoreAddrKw
            {width @paren(@bracket(@Width))}
        )
    }

    InstOp.LoadFromAddr @struct{
        syntax (
            @LoadAddrKw
            {width @paren(@bracket(@Width))}
        )
    }

    InstOp.WriteToSlot @struct{
        syntax (
            @WriteSlotKw
            {slot @paren(@SlotId)}
        )
    }

    InstOp.ReadFromSlot @struct{
        syntax (
            @ReadSlotKw
            {slot @paren(@SlotId)}
        )
    }

    InstOp.CallIntrinsic @struct{
        syntax (
            @CallIntrinsicKw
            {func @paren(@IntrinsicRef)}
        )
    }

    InstOp.CallPure @struct{
        syntax (
            @CallPureKw
            {func @paren(@IntrinsicRef)}
        )
    }

    InstOp.CallEffect @struct{
        syntax (
            @CallEffectKw
            {func @paren(@IntrinsicRef)}
        )
    }

    InstOp.CallLambda @struct{
        syntax (
            @CallLambdaKw
            {target @paren(@LambdaId)}
        )
    }

    Inst @struct{
        syntax (
            @InstKw
            @soft_space
            {id @InstId}
            @Colon
            @optional(
                @soft_space
                {defs @separated_by(@Operand ",")}
                @soft_space
                @Equals
            )
            @soft_space
            {op @InstOp}
            @optional(
                @soft_space
                {uses @separated_by(@Operand ",")}
            )
            @optional(
                @Bang
                {clobbers @ClobberKind}
            )
        )
    }

    Terminator @enum

    Terminator.Return @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @ReturnKw
        )
    }

    Terminator.Branch @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @BranchKw
            @soft_space
            {edge @EdgeId}
        )
    }

    Terminator.BranchIf @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @BranchIfKw
            @soft_space
            {cond @VReg}
            @soft_space
            @Arrow
            @soft_space
            {taken @EdgeId}
            @Comma
            @soft_space
            @FallthroughKw
            @soft_space
            {fallthrough @EdgeId}
        )
    }

    Terminator.BranchIfZero @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @BranchIfZeroKw
            @soft_space
            {cond @VReg}
            @soft_space
            @Arrow
            @soft_space
            {taken @EdgeId}
            @Comma
            @soft_space
            @FallthroughKw
            @soft_space
            {fallthrough @EdgeId}
        )
    }

    Terminator.JumpTable @struct{
        syntax (
            @TermKw
            @soft_space
            {id @TermId}
            @Colon
            @soft_space
            @JumpTableKw
            @soft_space
            {predicate @VReg}
            @soft_space
            {targets @bracket_list(@EdgeId ",")}
            @Comma
            @soft_space
            "default"
            @soft_space
            {default @EdgeId}
        )
    }
}
