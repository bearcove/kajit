/// Human-facing representation name.
name HIR

/// Canonical text file extension for HIR documents.
file_ext .k-hir

/// High-level purpose of this representation.
description "Human-semantic structured IR; canonical print round-trip with required provenance."

/// Hard conventions for this representation family.
///
/// These are fixed by foundation-crate policy and intentionally not
/// parameterizable in-schema.
conventions {
    /// AST structure is derived from `rules` only.
    ast_source rules
    /// Every generated struct implicitly carries provenance.
    implicit_struct_field "prov @Prov"
    /// Variant structs are discovered from `Type.Variant @struct`.
    enum_variants "dotted-variant-structs"
    /// Fields are discovered from `{name @Type}` bindings in `syntax`.
    field_source "syntax-bindings"
    /// Leading doc comments (`///`) are captured by convention.
    docs_capture "leading-triple-slash"
    /// Docs are retained for top-level declarations only.
    docs_on (Module TypeDef Function)
}

/// Grammar rules for the currently supported pilot subset.
rules {
    keyword @group{
        ModuleKw "module"
        FnKw "fn"
        ReturnKw "return"
        CallKw "call"
    }

    operator @group{
        LBrace "{"
        RBrace "}"
        LParen "("
        RParen ")"
        Comma ","
        Colon ":"
        Arrow "->"
    }

    Ident {
        syntax @regex("[A-Za-z_][A-Za-z0-9_]*")
    }

    Symbol {
        syntax @regex("@[A-Za-z_][A-Za-z0-9_.]*")
    }

    Int {
        syntax @regex("[0-9]+")
    }

    function @group{
        FunctionName {syntax @Ident}
        Callee {syntax @Symbol}
    }

    type @group{
        TypeName {syntax @Ident}
    }

    parameter @group{
        ParamName {syntax @Ident}
    }

    variable @group{
        LocalName {syntax @Ident}
    }

    number @group{
        IntLiteral {syntax @Int}
    }

    /// A module with a flat list of functions.
    Module @struct{
        syntax @brace_block(
            prefix (
                @ModuleKw
                @soft_space
            )
            body {functions @many(@Function @newline)}
        )
    }

    /// A function signature plus structured body.
    Function @struct{
        syntax (
            @FnKw
            @soft_space
            {name @FunctionName}
            {params @paren_list(@Param ",")}
            @soft_space
            @Arrow
            @soft_space
            {return_type @TypeName}
            @soft_space
            {body @Block}
        )
    }

    /// A single function parameter.
    Param @struct{
        syntax (
            {name @ParamName}
            @Colon
            @soft_space
            {ty @TypeName}
        )
    }

    /// A braced statement block.
    Block @struct{
        syntax @brace_block(
            body {statements @many(@Stmt @newline)}
        )
    }

    /// Statement forms supported by the pilot parser.
    Stmt @enum

    /// A return statement with an optional value.
    Stmt.Return @struct{
        syntax (
            @ReturnKw
            @optional(
                @soft_space
                {value @Expr}
            )
        )
    }

    /// A bare expression used as a statement.
    Stmt.Expr @struct{
        syntax ({value @Expr})
    }

    /// Expression forms supported by the pilot parser.
    Expr @enum

    /// A symbolic function call.
    Expr.Call @struct{
        syntax (
            @CallKw
            @soft_space
            {callee @Callee}
            {args @paren_list(@Expr ",")}
        )
    }

    /// A local value reference.
    Expr.Local @struct{
        syntax ({name @LocalName})
    }

    /// A decimal integer literal.
    Expr.Literal @struct{
        syntax ({value @IntLiteral})
    }
}
