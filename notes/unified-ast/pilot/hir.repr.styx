/// Human-facing representation name.
name HIR

/// Canonical text file extension for HIR documents.
file_ext .k-hir

/// High-level purpose of this representation.
description "Human-semantic structured IR; canonical print round-trip with required provenance."

/// Grammar rules for the currently supported pilot subset.
rules {
    templates {
        Keyword {
            syntax @template{
                params ({text @Any})
                body {
                    syntax text
                    highlight keyword
                }
            }
        }

        Operator {
            syntax @template{
                params ({text @Any})
                body {
                    syntax text
                    highlight operator
                }
            }
        }

        FunctionToken {
            syntax @template{
                params ({inner @Any})
                body {
                    syntax inner
                    highlight function
                }
            }
        }

        TypeToken {
            syntax @template{
                params ({inner @Any})
                body {
                    syntax inner
                    highlight type
                }
            }
        }

        ParameterToken {
            syntax @template{
                params ({inner @Any})
                body {
                    syntax inner
                    highlight parameter
                }
            }
        }

        VariableToken {
            syntax @template{
                params ({inner @Any})
                body {
                    syntax inner
                    highlight variable
                }
            }
        }

        NumberToken {
            syntax @template{
                params ({inner @Any})
                body {
                    syntax inner
                    highlight number
                }
            }
        }
    }

    ModuleKw @Keyword("module")
    FnKw @Keyword("fn")
    ReturnKw @Keyword("return")
    CallKw @Keyword("call")

    LBrace @Operator("{")
    RBrace @Operator("}")
    LParen @Operator("(")
    RParen @Operator(")")
    Comma @Operator(",")
    Colon @Operator(":")
    Arrow @Operator("->")

    Ident {
        syntax @regex("[A-Za-z_][A-Za-z0-9_]*")
    }

    Symbol {
        syntax @regex("@[A-Za-z_][A-Za-z0-9_.]*")
    }

    Int {
        syntax @regex("[0-9]+")
    }

    FunctionName @FunctionToken(@Ident)
    Callee @FunctionToken(@Symbol)

    TypeName @TypeToken(@Ident)

    ParamName @ParameterToken(@Ident)

    LocalName @VariableToken(@Ident)

    IntLiteral @NumberToken(@Int)

    /// A module with a flat list of functions.
    Module @struct{
        syntax @brace_block(
            prefix (
                @ModuleKw
                @soft_space
            )
            body {functions @many(@Function @newline)}
        )
    }

    /// A function signature plus structured body.
    Function @struct{
        syntax (
            @FnKw
            @soft_space
            {name @FunctionName}
            {params @paren_list(@Param ",")}
            @soft_space
            @Arrow
            @soft_space
            {return_type @TypeName}
            @soft_space
            {body @Block}
        )
    }

    /// A single function parameter.
    Param @struct{
        syntax (
            {name @ParamName}
            @Colon
            @soft_space
            {ty @TypeName}
        )
    }

    /// A braced statement block.
    Block @struct{
        syntax @brace_block(
            body {statements @many(@Stmt @newline)}
        )
    }

    /// Statement forms supported by the pilot parser.
    Stmt @enum

    /// A return statement with an optional value.
    Stmt.Return @struct{
        syntax (
            @ReturnKw
            @optional(
                @soft_space
                {value @Expr}
            )
        )
    }

    /// A bare expression used as a statement.
    Stmt.Expr @struct{
        syntax ({value @Expr})
    }

    /// Expression forms supported by the pilot parser.
    Expr @enum

    /// A symbolic function call.
    Expr.Call @struct{
        syntax (
            @CallKw
            @soft_space
            {callee @Callee}
            {args @paren_list(@Expr ",")}
        )
    }

    /// A local value reference.
    Expr.Local @struct{
        syntax ({name @LocalName})
    }

    /// A decimal integer literal.
    Expr.Literal @struct{
        syntax ({value @IntLiteral})
    }
}
