meta {
    /// Stable identifier for this pilot schema document.
    id kajit:repr-schema/asm-pilot
    /// Schema revision for the pilot format itself.
    version 1
    /// Human summary of the pilot's purpose.
    description "Pilot representation schema for Kajit ASM"
}

/// Pilot schema for the ASM representation family.
repr @module{
    /// Human-facing representation name.
    name ASM
    /// Canonical text file extension for ASM documents.
    file_ext .k-asm

    /// High-level stage contract for ASM.
    contract {
        /// What this stage is for in the pipeline.
        purpose "Symbolic architecture-specific assembly"
        /// Names/identities that remain canonical in printed ASM.
        canonical_identities (dialect label-name register-name)
        /// Required round-trip guarantee for the stage text format.
        round_trip canonical-print
        /// Provenance expectation for nodes at this stage.
        provenance required
    }

    /// Text-format description for the pilot ASM subset.
    syntax {
        /// Root rule and root AST node for parsed ASM documents.
        root Program

        /// Token classes used by the pilot parser.
        tokens {
            /// A bare identifier used for labels.
            ident @regex("[A-Za-z_][A-Za-z0-9_]*")
            /// A decimal integer literal token.
            int @regex("[0-9]+")
        }

        /// Grammar rules for the currently supported pilot subset.
        rules {
            /// A whole assembly program, disambiguated by dialect header.
            Program @choice(
                /// An AArch64 assembly unit.
                @variant(AArch64 @seq(
                    "asm"
                    "aarch64"
                    "{"
                    @field(items @repeat(@ref(A64Item)))
                    "}"
                ))
                /// An x86-64 assembly unit.
                @variant(X86_64 @seq(
                    "asm"
                    "x86_64"
                    "{"
                    @field(items @repeat(@ref(X64Item)))
                    "}"
                ))
            )

            /// The AArch64 register subset supported by the pilot.
            A64Reg @choice(
                @variant(X0 @seq("x0"))
                @variant(X1 @seq("x1"))
                @variant(X2 @seq("x2"))
                @variant(X3 @seq("x3"))
                @variant(Sp @seq("sp"))
            )

            /// AArch64 labels and instructions.
            A64Item @choice(
                /// A symbolic label definition.
                @variant(Label @seq(
                    @field(name @token(ident))
                    ":"
                ))
                /// Return from the current function.
                @variant(Ret @seq(
                    "ret"
                ))
                /// A no-op instruction.
                @variant(Nop @seq(
                    "nop"
                ))
                /// Move an immediate into a register.
                @variant(Movz @seq(
                    "movz"
                    @field(rd @ref(A64Reg))
                    ","
                    @field(imm @token(int))
                ))
                /// Move a register into another register.
                @variant(Mov @seq(
                    "mov"
                    @field(rd @ref(A64Reg))
                    ","
                    @field(rm @ref(A64Reg))
                ))
                /// Add an immediate to a register.
                @variant(AddImm @seq(
                    "add"
                    @field(rd @ref(A64Reg))
                    ","
                    @field(rn @ref(A64Reg))
                    ","
                    @field(imm @token(int))
                ))
                /// Branch to a label.
                @variant(B @seq(
                    "b"
                    @field(target @token(ident))
                ))
            )

            /// The x86-64 register subset supported by the pilot.
            X64Reg @choice(
                @variant(Rax @seq("rax"))
                @variant(Rbx @seq("rbx"))
                @variant(Rcx @seq("rcx"))
                @variant(Rdx @seq("rdx"))
                @variant(Rsp @seq("rsp"))
                @variant(Rbp @seq("rbp"))
            )

            /// x86-64 labels and instructions.
            X64Item @choice(
                /// A symbolic label definition.
                @variant(Label @seq(
                    @field(name @token(ident))
                    ":"
                ))
                /// Return from the current function.
                @variant(Ret @seq(
                    "ret"
                ))
                /// A no-op instruction.
                @variant(Nop @seq(
                    "nop"
                ))
                /// Move an immediate into a register.
                @variant(MovImm @seq(
                    "mov"
                    @field(rd @ref(X64Reg))
                    ","
                    @field(imm @token(int))
                ))
                /// Move a register into another register.
                @variant(MovReg @seq(
                    "mov"
                    @field(rd @ref(X64Reg))
                    ","
                    @field(rm @ref(X64Reg))
                ))
                /// Add an immediate to a register.
                @variant(AddImm @seq(
                    "add"
                    @field(rd @ref(X64Reg))
                    ","
                    @field(imm @token(int))
                ))
                /// Jump to a label.
                @variant(Jmp @seq(
                    "jmp"
                    @field(target @token(ident))
                ))
            )
        }

        /// Canonical printer templates for the pilot subset.
        canonical_print {
            /// Canonical AArch64 program layout.
            Program.AArch64 "asm aarch64 {\n{items}\n}"
            /// Canonical x86-64 program layout.
            Program.X86_64 "asm x86_64 {\n{items}\n}"

            A64Reg.X0 "x0"
            A64Reg.X1 "x1"
            A64Reg.X2 "x2"
            A64Reg.X3 "x3"
            A64Reg.Sp "sp"

            A64Item.Label "{name}:"
            A64Item.Ret "ret"
            A64Item.Nop "nop"
            A64Item.Movz "movz {rd}, {imm}"
            A64Item.Mov "mov {rd}, {rm}"
            A64Item.AddImm "add {rd}, {rn}, {imm}"
            A64Item.B "b {target}"

            X64Reg.Rax "rax"
            X64Reg.Rbx "rbx"
            X64Reg.Rcx "rcx"
            X64Reg.Rdx "rdx"
            X64Reg.Rsp "rsp"
            X64Reg.Rbp "rbp"

            X64Item.Label "{name}:"
            X64Item.Ret "ret"
            X64Item.Nop "nop"
            X64Item.MovImm "mov {rd}, {imm}"
            X64Item.MovReg "mov {rd}, {rm}"
            X64Item.AddImm "add {rd}, {imm}"
            X64Item.Jmp "jmp {target}"
        }
    }

    /// Shared scalar-ish building blocks reused by multiple nodes.
    common {
        /// Node provenance payload.
        provenance @Prov
        /// Free-form doc block payload collected from leading `///` comments.
        docs @DocBlock
    }

    /// Semantic support types that are not themselves structural nodes.
    support {
        /// A symbolic label name.
        LabelName @string
        /// A decimal immediate value in canonical ASM text.
        Imm @string
    }

    /// Structural AST nodes for the pilot ASM surface.
    nodes {
        /// The root ASM program, with an explicit in-file dialect.
        Program @enum{
            /// An AArch64 assembly unit.
            AArch64 @struct{
                /// Optional program-level docs.
                docs @optional(@DocBlock)
                /// Ordered labels and instructions.
                items @seq(@A64Item)
            }

            /// An x86-64 assembly unit.
            X86_64 @struct{
                /// Optional program-level docs.
                docs @optional(@DocBlock)
                /// Ordered labels and instructions.
                items @seq(@X64Item)
            }
        }

        /// The AArch64 register subset supported by the pilot.
        A64Reg @enum{
            X0 @struct{}
            X1 @struct{}
            X2 @struct{}
            X3 @struct{}
            Sp @struct{}
        }

        /// AArch64 labels and instructions.
        A64Item @enum{
            /// A symbolic label definition.
            Label @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Label name.
                name @LabelName
            }

            /// A return instruction.
            Ret @struct{
                /// Source provenance for the item.
                prov @Prov
            }

            /// A no-op instruction.
            Nop @struct{
                /// Source provenance for the item.
                prov @Prov
            }

            /// Move an immediate into a register.
            Movz @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Destination register.
                rd @A64Reg
                /// Immediate value.
                imm @Imm
            }

            /// Move a register into another register.
            Mov @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Destination register.
                rd @A64Reg
                /// Source register.
                rm @A64Reg
            }

            /// Add an immediate to a register.
            AddImm @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Destination register.
                rd @A64Reg
                /// Base register.
                rn @A64Reg
                /// Immediate value.
                imm @Imm
            }

            /// Branch to a symbolic label.
            B @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Branch target label.
                target @LabelName
            }
        }

        /// The x86-64 register subset supported by the pilot.
        X64Reg @enum{
            Rax @struct{}
            Rbx @struct{}
            Rcx @struct{}
            Rdx @struct{}
            Rsp @struct{}
            Rbp @struct{}
        }

        /// x86-64 labels and instructions.
        X64Item @enum{
            /// A symbolic label definition.
            Label @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Label name.
                name @LabelName
            }

            /// A return instruction.
            Ret @struct{
                /// Source provenance for the item.
                prov @Prov
            }

            /// A no-op instruction.
            Nop @struct{
                /// Source provenance for the item.
                prov @Prov
            }

            /// Move an immediate into a register.
            MovImm @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Destination register.
                rd @X64Reg
                /// Immediate value.
                imm @Imm
            }

            /// Move a register into another register.
            MovReg @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Destination register.
                rd @X64Reg
                /// Source register.
                rm @X64Reg
            }

            /// Add an immediate to a register.
            AddImm @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Destination register.
                rd @X64Reg
                /// Immediate value.
                imm @Imm
            }

            /// Jump to a symbolic label.
            Jmp @struct{
                /// Source provenance for the item.
                prov @Prov
                /// Jump target label.
                target @LabelName
            }
        }
    }
}
