/// Human-facing representation name.
name ASM

/// Canonical text file extension for ASM documents.
file_ext .k-asm

/// High-level purpose of this representation.
description "Symbolic architecture-specific assembly with canonical print round-trip and required provenance."

/// Hard conventions for this representation family.
///
/// These are fixed by foundation-crate policy and intentionally not
/// parameterizable in-schema.
conventions {
    /// AST structure is derived from `rules` only.
    ast_source rules
    /// Every generated struct implicitly carries provenance.
    implicit_struct_field "prov @Prov"
    /// Variant structs are discovered from `Type.Variant @struct`.
    enum_variants "dotted-variant-structs"
    /// Fields are discovered from `{name @Type}` bindings in `syntax`.
    field_source "syntax-bindings"
    /// Leading doc comments (`///`) are captured by convention.
    docs_capture "leading-triple-slash"
    /// Docs are retained for top-level declarations only.
    docs_on (Program.AArch64 Program.X86_64)
}

/// Grammar rules for the currently supported pilot subset.
rules {
    keyword @group{
        AsmKw "asm"
        AArch64Dialect "aarch64"
        X86_64Dialect "x86_64"
        RetKw "ret"
        NopKw "nop"
        MovKw "mov"
        MovzKw "movz"
        AddKw "add"
        SubKw "sub"
        BKw "b"
        JmpKw "jmp"
    }

    operator @group{
        LBrace "{"
        RBrace "}"
        Colon ":"
        Comma ","
    }

    Ident {
        syntax @regex("[A-Za-z_][A-Za-z0-9_]*")
    }

    Int {
        syntax @regex("[0-9]+")
    }

    label @group{
        LabelName {syntax @Ident}
    }

    number @group{
        Imm {syntax @Int}
    }

    A64Reg @enum

    A64Reg.X0 "x0"
    A64Reg.X1 "x1"
    A64Reg.X2 "x2"
    A64Reg.X3 "x3"
    A64Reg.Sp "sp"

    X64Reg @enum

    X64Reg.Rax "rax"
    X64Reg.Rbx "rbx"
    X64Reg.Rcx "rcx"
    X64Reg.Rdx "rdx"
    X64Reg.Rsp "rsp"
    X64Reg.Rbp "rbp"

    /// A whole assembly program, disambiguated by dialect header.
    Program @enum

    /// An AArch64 assembly unit.
    Program.AArch64 @struct{
        syntax @brace_block(
            prefix (
                @AsmKw
                @soft_space
                @AArch64Dialect
                @soft_space
            )
            body {items @many(@A64Item @newline)}
        )
    }

    /// An x86-64 assembly unit.
    Program.X86_64 @struct{
        syntax @brace_block(
            prefix (
                @AsmKw
                @soft_space
                @X86_64Dialect
                @soft_space
            )
            body {items @many(@X64Item @newline)}
        )
    }

    /// AArch64 labels and instructions.
    A64Item @enum

    /// A symbolic label definition.
    A64Item.Label @struct{
        syntax ({name @LabelName} @Colon)
    }

    /// Return from the current function.
    A64Item.Ret @struct{
        syntax (@RetKw)
    }

    /// A no-op instruction.
    A64Item.Nop @struct{
        syntax (@NopKw)
    }

    /// Move an immediate into a register.
    A64Item.Movz @struct{
        syntax (
            @MovzKw
            @soft_space
            {rd @A64Reg}
            @Comma
            @soft_space
            {imm @Imm}
        )
    }

    /// Move a register into another register.
    A64Item.Mov @struct{
        syntax (
            @MovKw
            @soft_space
            {rd @A64Reg}
            @Comma
            @soft_space
            {rm @A64Reg}
        )
    }

    /// Add an immediate to a register.
    A64Item.AddImm @struct{
        syntax (
            @AddKw
            @soft_space
            {rd @A64Reg}
            @Comma
            @soft_space
            {rn @A64Reg}
            @Comma
            @soft_space
            {imm @Imm}
        )
    }

    /// Add a register to a register.
    A64Item.AddReg @struct{
        syntax (
            @AddKw
            @soft_space
            {rd @A64Reg}
            @Comma
            @soft_space
            {rn @A64Reg}
            @Comma
            @soft_space
            {rm @A64Reg}
        )
    }

    /// Subtract a register from a register.
    A64Item.SubReg @struct{
        syntax (
            @SubKw
            @soft_space
            {rd @A64Reg}
            @Comma
            @soft_space
            {rn @A64Reg}
            @Comma
            @soft_space
            {rm @A64Reg}
        )
    }

    /// Branch to a label.
    A64Item.B @struct{
        syntax (
            @BKw
            @soft_space
            {target @LabelName}
        )
    }

    /// x86-64 labels and instructions.
    X64Item @enum

    /// A symbolic label definition.
    X64Item.Label @struct{
        syntax ({name @LabelName} @Colon)
    }

    /// Return from the current function.
    X64Item.Ret @struct{
        syntax (@RetKw)
    }

    /// A no-op instruction.
    X64Item.Nop @struct{
        syntax (@NopKw)
    }

    /// Move an immediate into a register.
    X64Item.MovImm @struct{
        syntax (
            @MovKw
            @soft_space
            {rd @X64Reg}
            @Comma
            @soft_space
            {imm @Imm}
        )
    }

    /// Move a register into another register.
    X64Item.MovReg @struct{
        syntax (
            @MovKw
            @soft_space
            {rd @X64Reg}
            @Comma
            @soft_space
            {rm @X64Reg}
        )
    }

    /// Add an immediate to a register.
    X64Item.AddImm @struct{
        syntax (
            @AddKw
            @soft_space
            {rd @X64Reg}
            @Comma
            @soft_space
            {imm @Imm}
        )
    }

    /// Add a register to a register.
    X64Item.AddReg @struct{
        syntax (
            @AddKw
            @soft_space
            {rd @X64Reg}
            @Comma
            @soft_space
            {rm @X64Reg}
        )
    }

    /// Subtract a register from a register.
    X64Item.SubReg @struct{
        syntax (
            @SubKw
            @soft_space
            {rd @X64Reg}
            @Comma
            @soft_space
            {rm @X64Reg}
        )
    }

    /// Jump to a label.
    X64Item.Jmp @struct{
        syntax (
            @JmpKw
            @soft_space
            {target @LabelName}
        )
    }
}
