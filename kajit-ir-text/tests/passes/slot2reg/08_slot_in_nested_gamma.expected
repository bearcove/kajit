state_domains {
  d0 = memory
}
scopes {
  s0 = lambda_body(@0)
  s1 = gamma_branch(0) parent s0
  s2 = gamma_branch(0) parent s1
  s3 = gamma_branch(1) parent s1
  s4 = gamma_branch(1) parent s0
}
lambda @0 @s0 (shape: "test") {
  region @s0 {
    args: [%ms]
    n1 = Const(0x2a) [] -> [v0]
    n3 = Const(0x0) [] -> [v1]
    n10 = gamma [
      pred: v1
      in0: v0
      in1: %ms:arg
    ] {
      branch 0:
        region @s1 {
          args: [arg0, %ms]
          n4 = Const(0x1) [] -> [v2]
          n9 = gamma [
            pred: v2
            in0: arg0
            in1: %ms:arg
          ] {
            branch 0:
              region @s2 {
                args: [arg0, %ms]
                n6 = WriteToField(offset=0, W4) [arg0, %ms:arg] -> [%ms]
                results: [arg0, %ms:n6]
              }
            branch 1:
              region @s3 {
                args: [arg0, %ms]
                n8 = WriteToField(offset=0, W4) [arg0, %ms:arg] -> [%ms]
                results: [arg0, %ms:n8]
              }
          } -> [v5, %ms]
          results: [v5, %ms:n9]
        }
      branch 1:
        region @s4 {
          args: [arg0, %ms]
          results: [arg0, %ms:arg]
        }
    } -> [v6, %ms]
    results: [%ms:n10]
  }
}
