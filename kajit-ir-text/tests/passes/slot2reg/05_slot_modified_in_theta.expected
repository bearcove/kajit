state_domains {
  d0 = output
  d1 = memory
}
scopes {
  s0 = lambda_body(@0)
  s1 = theta_body parent s0
}
lambda @0 @s0 (shape: "test") {
  region @s0 {
    args: [%ms, %os]
    n1 = Const(0x0) [] -> [v0]
    n9 = theta [v0, %ms:arg, %os:arg] {
      region @s1 {
        args: [arg0, %ms, %os]
        n4 = Const(0x1) [] -> [v2]
        n5 = Add [arg0, v2] -> [v3]
        n7 = Const(0xa) [] -> [v4]
        n8 = Sub [v4, v3] -> [v5]
        results: [v5, v3, %ms:arg, %os:arg]
      }
    } -> [v7, %ms, %os]
    n11 = WriteToField(offset=0, W4) [v7, %os:n9] -> [%os]
    results: [%ms:n9, %os:n11]
  }
}
