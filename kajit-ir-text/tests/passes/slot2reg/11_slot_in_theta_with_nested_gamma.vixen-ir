lambda @0 (shape: "test") {
  region {
    args: [%ms, %os]
    n0 = Const(0x0) [] -> [v0]
    n1 = WriteToSlot(0) [v0, %ms:arg] -> [%ms]
    n10 = theta [%ms:n1, %os:arg] {
      region {
        args: [%ms, %os]
        n2 = Const(0x1) [] -> [v1]
        n9 = gamma [
          pred: v1
          in0: %ms:arg
          in1: %os:arg
        ] {
          branch 0:
            region {
              args: [%ms, %os]
              results: [%ms:arg, %os:arg]
            }
          branch 1:
            region {
              args: [%ms, %os]
              n3 = Const(0x1) [] -> [v2]
              n4 = ReadFromSlot(0) [%ms:arg] -> [v3, %ms]
              n5 = Add [v3, v2] -> [v4]
              n6 = WriteToSlot(0) [v4, %ms:n4] -> [%ms]
              results: [%ms:n6, %os:arg]
            }
        } -> [%ms, %os]
        n7 = Const(0x0) [] -> [v5]
        results: [v5, %ms:n9, %os:n9]
      }
    } -> [%ms, %os]
    n8 = ReadFromSlot(0) [%ms:n10] -> [v6, %ms]
    n11 = WriteToField(offset=0, W4) [v6, %os:n10] -> [%os]
    results: [%ms:n8, %os:n11]
  }
}
