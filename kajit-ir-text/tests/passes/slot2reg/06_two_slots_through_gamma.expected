scopes {
  s0 = lambda_body(@0)
  s1 = gamma_branch(0) parent s0
  s2 = gamma_branch(1) parent s0
}
lambda @0 @s0 (shape: "test") {
  region @s0 {
    args: [%ms]
    n1 = Const(0x1) [] -> [v0]
    n2 = Const(0x2) [] -> [v1]
    n5 = Const(0x0) [] -> [v2]
    n12 = gamma [
      pred: v2
      in0: v0
      in1: v1
      in2: %ms:arg
    ] {
      branch 0:
        region @s1 {
          args: [arg0, arg1, %ms]
          n8 = Add [arg0, arg1] -> [v5]
          n9 = WriteToField(offset=0, W4) [v5, %ms:arg] -> [%ms]
          results: [arg0, arg1, %ms:n9]
        }
      branch 1:
        region @s2 {
          args: [arg0, arg1, %ms]
          results: [arg0, arg1, %ms:arg]
        }
    } -> [v8, v9, %ms]
    results: [%ms:n12]
  }
}
