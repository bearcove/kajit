lambda @0 (shape: "test") {
  region {
    args: [%ms]
    n0 = Const(0x2a) [] -> [v0]
    n1 = WriteToSlot(0) [v0, %ms:arg] -> [%ms]
    n2 = Const(0x0) [] -> [v1]
    n7 = gamma [
      pred: v1
      in0: %ms:n1
    ] {
      branch 0:
        region {
          args: [%ms]
          n3 = ReadFromSlot(0) [%ms:arg] -> [v2, %ms]
          n4 = WriteToField(offset=0, W4) [v2, %ms:n3] -> [%ms]
          results: [%ms:n4]
        }
      branch 1:
        region {
          args: [%ms]
          n5 = ErrorExit(UnexpectedEof) [%ms:arg] -> []
          results: [%ms:arg]
        }
    } -> [%ms]
    results: [%ms:n7]
  }
}
