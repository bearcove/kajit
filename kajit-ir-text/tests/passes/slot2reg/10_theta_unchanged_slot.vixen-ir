lambda @0 (shape: "test") {
  region {
    args: [%ms, %os]
    n0 = Const(0x2a) [] -> [v0]
    n1 = WriteToSlot(0) [v0, %ms:arg] -> [%ms]
    n6 = theta [%ms:n1, %os:arg] {
      region {
        args: [%ms, %os]
        n2 = ReadFromSlot(0) [%ms:arg] -> [v1, %ms]
        n3 = WriteToField(offset=0, W4) [v1, %os:arg] -> [%os]
        n4 = Const(0x0) [] -> [v2]
        results: [v2, %ms:n2, %os:n3]
      }
    } -> [%ms, %os]
    results: [%ms:n6, %os:n6]
  }
}
