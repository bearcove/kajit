lambda @0 (shape: "test") {
  region {
    args: [%ms, %os]
    n0 = Const(0x0) [] -> [v0]
    n1 = WriteToSlot(0) [v0, %ms:arg] -> [%ms]
    n8 = theta [%ms:n1, %os:arg] {
      region {
        args: [%ms, %os]
        n2 = ReadFromSlot(0) [%ms:arg] -> [v1, %ms]
        n3 = Const(0x1) [] -> [v2]
        n4 = Add [v1, v2] -> [v3]
        n5 = WriteToSlot(0) [v3, %ms:n2] -> [%ms]
        n6 = Const(0xa) [] -> [v4]
        n7 = Sub [v4, v3] -> [v5]
        results: [v5, %ms:n5, %os:arg]
      }
    } -> [%ms, %os]
    n9 = ReadFromSlot(0) [%ms:n8] -> [v6, %ms]
    n10 = WriteToField(offset=0, W4) [v6, %os:n8] -> [%os]
    results: [%ms:n9, %os:n10]
  }
}
