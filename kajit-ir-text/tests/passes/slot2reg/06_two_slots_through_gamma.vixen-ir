lambda @0 (shape: "test") {
  region {
    args: [%ms, %os]
    n0 = Const(0x1) [] -> [v0]
    n1 = Const(0x2) [] -> [v1]
    n2 = WriteToSlot(0) [v0, %ms:arg] -> [%ms]
    n3 = WriteToSlot(1) [v1, %ms:n2] -> [%ms]
    n4 = Const(0x0) [] -> [v2]
    n11 = gamma [
      pred: v2
      in0: %ms:n3
      in1: %os:arg
    ] {
      branch 0:
        region {
          args: [%ms, %os]
          n5 = ReadFromSlot(0) [%ms:arg] -> [v3, %ms]
          n6 = ReadFromSlot(1) [%ms:n5] -> [v4, %ms]
          n7 = Add [v3, v4] -> [v5]
          n8 = WriteToField(offset=0, W4) [v5, %os:arg] -> [%os]
          results: [%ms:n6, %os:n8]
        }
      branch 1:
        region {
          args: [%ms, %os]
          n9 = ReadFromSlot(0) [%ms:arg] -> [v6, %ms]
          n10 = ReadFromSlot(1) [%ms:n9] -> [v7, %ms]
          results: [%ms:n10, %os:arg]
        }
    } -> [%ms, %os]
    results: [%ms:n11, %os:n11]
  }
}
