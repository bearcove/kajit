lambda @0 (shape: "test") {
  region {
    args: [%ms]
    n0 = Const(0xa) [] -> [v0]
    n1 = WriteToSlot(0) [v0, %ms:arg] -> [%ms]
    n6 = theta [%ms:n1] {
      region {
        args: [%ms]
        n2 = ReadFromSlot(0) [%ms:arg] -> [v1, %ms]
        n3 = WriteToField(offset=0, W4) [v1, %ms:n2] -> [%ms]
        n4 = Const(0x0) [] -> [v2]
        results: [v2, %ms:n3]
      }
    } -> [%ms]
    results: [%ms:n6]
  }
}
