state_domains {
  d0 = output
  d1 = memory
}
scopes {
  s0 = lambda_body(@0)
  s1 = theta_body parent s0
}
lambda @0 @s0 (shape: "test") {
  region @s0 {
    args: [%ms, %os]
    n1 = Const(0x2a) [] -> [v0]
    n6 = theta [v0, %ms:arg, %os:arg] {
      region @s1 {
        args: [arg0, %ms, %os]
        n4 = WriteToField(offset=0, W4) [arg0, %os:arg] -> [%os]
        n5 = Const(0x0) [] -> [v2]
        n7 = Identity [arg0] -> [v3]
        results: [v2, v3, %ms:arg, %os:n4]
      }
    } -> [v4, %ms, %os]
    results: [%ms:n6, %os:n6]
  }
}
