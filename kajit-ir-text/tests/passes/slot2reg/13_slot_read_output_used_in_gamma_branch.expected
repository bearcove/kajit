scopes {
  s0 = lambda_body(@0)
  s1 = gamma_branch(0) parent s0
  s2 = gamma_branch(1) parent s0
}
lambda @0 @s0 (shape: "test") {
  region @s0 {
    args: [%ms]
    n1 = Const(0x2a) [] -> [v0]
    n4 = Const(0x0) [] -> [v2]
    n7 = gamma [
      pred: v2
      in0: %ms:arg
    ] {
      branch 0:
        region @s1 {
          args: [%ms]
          n5 = WriteToField(offset=0, W4) [v0, %ms:arg] -> [%ms]
          results: [%ms:n5]
        }
      branch 1:
        region @s2 {
          args: [%ms]
          n6 = WriteToField(offset=0, W4) [v0, %ms:arg] -> [%ms]
          results: [%ms:n6]
        }
    } -> [%ms]
    results: [%ms:n7]
  }
}
