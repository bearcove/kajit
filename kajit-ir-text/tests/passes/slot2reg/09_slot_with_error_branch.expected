state_domains {
  d0 = output
  d1 = memory
}
scopes {
  s0 = lambda_body(@0)
  s1 = gamma_branch(0) parent s0
  s2 = gamma_branch(1) parent s0
}
lambda @0 @s0 (shape: "test") {
  region @s0 {
    args: [%ms, %os]
    n1 = Const(0x2a) [] -> [v0]
    n3 = Const(0x0) [] -> [v1]
    n7 = gamma [
      pred: v1
      in0: v0
      in1: %ms:arg
      in2: %os:arg
    ] {
      branch 0:
        region @s1 {
          args: [arg0, %ms, %os]
          n5 = WriteToField(offset=0, W4) [arg0, %os:arg] -> [%os]
          results: [arg0, %ms:arg, %os:n5]
        }
      branch 1:
        region @s2 {
          args: [arg0, %ms, %os]
          n6 = ErrorExit(UnexpectedEof) [%ms:arg] -> []
          results: [arg0, %ms:arg, %os:arg]
        }
    } -> [v3, %ms, %os]
    results: [%ms:n7, %os:n7]
  }
}
