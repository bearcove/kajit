state_domains {
  d0 = output
  d1 = memory
}
scopes {
  s0 = lambda_body(@0)
}
lambda @0 @s0 (shape: "test") {
  region @s0 {
    args: [%ms, %os]
    n0 = Const(0x2) [] -> [v0]
    n1 = Const(0x3) [] -> [v1]
    n2 = Add [v0, v1] -> [v2]
    n3 = Const(0x4) [] -> [v3]
    n4 = Mul [v2, v3] -> [v4]
    results: [%ms:arg, %os:arg]
  }
}
