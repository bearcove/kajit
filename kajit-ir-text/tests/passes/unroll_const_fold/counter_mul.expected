state_domains {
  d0 = memory
}
scopes {
  s0 = lambda_body(@0)
  s1 = theta_body parent s0
}
lambda @0 @s0 (shape: "u8") {
  region @s0 {
    args: [%ms]
    n1 = Const(0x0) [] -> [v0]
    n9 @s1 = Const(0x7) [] -> [?]
    n10 @s1 = Const(0x1) [] -> [?]
    n11 @s1 = Const(0x3) [] -> [?]
    n12 @s1 = Const(0x0) [] -> [?]
    n13 @s1 = Const(0x1) [] -> [?]
    n14 @s1 = Const(0x0) [] -> [?]
    results: [%ms:arg]
  }
}
