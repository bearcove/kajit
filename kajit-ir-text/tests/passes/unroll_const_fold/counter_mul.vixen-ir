state_domains {
  d0 = output
  d1 = memory
}
scopes {
  s0 = lambda_body(@0)
  s1 = theta_body parent s0
}
lambda @0 @s0 (shape: "u8") {
  region @s0 {
    args: [%ms, %os]
    n0 = Const(0x0) [] -> [v0]
    n1 = theta(max=3) [v0, %ms:arg, %os:arg] {
      region @s1 {
        args: [arg0, %ms, %os]
        n2 = Const(0x7) [] -> [v1]
        n3 = Const(0x1) [] -> [v2]
        n4 = Const(0x3) [] -> [v3]
        n5 = Mul [arg0, v1] -> [v4]
        n6 = Add [arg0, v2] -> [v5]
        n7 = CmpEq [v5, v3] -> [v6]
        results: [v6, v5, %ms:arg, %os:arg]
      }
    } -> [v7, %ms, %os]
    results: [%ms:n1, %os:n1]
  }
}
