state_domains {
  d0 = output
  d1 = memory
}
scopes {
  s0 = lambda_body(@0)
  s1 = theta_body parent s0
}
lambda @0 @s0 (shape: "u8") {
  region @s0 {
    args: [%ms, %os]
    n1 = Const(0x0) [] -> [v0]
    n2 = Const(0x0) [] -> [v1]
    n3 = Const(0x1) [] -> [v2]
    n12 @s1 = Const(0x7) [] -> [?]
    n13 @s1 = Const(0x1) [] -> [?]
    n14 @s1 = Const(0x0) [] -> [?]
    n15 @s1 = Const(0x1) [] -> [?]
    n16 @s1 = Const(0x1) [] -> [?]
    n17 @s1 = Const(0x1) [] -> [?]
    n18 = Const(0x1) [] -> [?]
    n19 = Const(0x1) [] -> [?]
    n20 = Const(0x1) [] -> [?]
    n21 @s1 = Const(0x7) [] -> [?]
    n22 @s1 = Const(0x1) [] -> [?]
    n23 @s1 = Const(0x7) [] -> [?]
    n24 @s1 = Const(0x80) [] -> [?]
    n25 @s1 = Const(0x81) [] -> [?]
    n26 @s1 = Const(0x2) [] -> [?]
    n27 = Const(0x2) [] -> [?]
    n28 = Const(0x81) [] -> [?]
    n29 = Const(0x1) [] -> [?]
    n30 @s1 = Const(0x7) [] -> [?]
    n31 @s1 = Const(0x1) [] -> [?]
    n32 @s1 = Const(0xe) [] -> [?]
    n33 @s1 = Const(0x4000) [] -> [?]
    n34 @s1 = Const(0x4081) [] -> [?]
    n35 @s1 = Const(0x3) [] -> [?]
    n11 = WriteToField(offset=0, W4) [n34.0, %os:arg] -> [%os]
    results: [%ms:arg, %os:n11]
  }
}
