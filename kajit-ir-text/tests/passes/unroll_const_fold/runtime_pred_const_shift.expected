state_domains {
  d0 = cursor
  d1 = output
}
scopes {
  s0 = lambda_body(@0)
  s1 = theta_body parent s0
}
lambda @0 @s0 (shape: "u8") {
  region @s0 {
    args: [%cs, %os]
    n1 = Const(0x0) [] -> [v0]
    n2 = Const(0x0) [] -> [v1]
    n3 = BoundsCheck(1) [%cs:arg] -> [%cs]
    n13 @s1 = Const(0x7) [] -> [?]
    n14 @s1 = Const(0x1) [] -> [?]
    n15 @s1 = Const(0x0) [] -> [?]
    n18 @s1 = Const(0x1) [] -> [?]
    n4 = ReadBytes(1) [%cs:n3] -> [v2, %cs]
    n16 @s1 = Identity [v2] -> [?]
    n17 @s1 = Identity [n16.0] -> [?]
    n34 = gamma [
      pred: v2
      in0: n18.0
      in1: n17.0
      in2: v2
      in3: %cs:n4
      in4: %os:arg
    ] {
      branch 0:
        region @s0 {
          args: [arg0, arg1, arg2, %cs, %os]
          results: [arg0, arg1, arg2, %cs:arg, %os:arg]
        }
      branch 1:
        region @s0 {
          args: [arg0, arg1, arg2, %cs, %os]
          n19 = Const(0x1) [] -> [?]
          n20 @s1 = Const(0x7) [] -> [?]
          n21 @s1 = Const(0x1) [] -> [?]
          n22 @s1 = Const(0x7) [] -> [?]
          n23 @s1 = Shl [arg2, n22.0] -> [?]
          n24 @s1 = Or [arg1, n23.0] -> [?]
          n25 @s1 = Const(0x2) [] -> [?]
          n33 = gamma [
            pred: arg2
            in0: n25.0
            in1: n24.0
            in2: arg2
            in3: %cs:arg
            in4: %os:arg
          ] {
            branch 0:
              region @s0 {
                args: [arg0, arg1, arg2, %cs, %os]
                results: [arg0, arg1, arg2, %cs:arg, %os:arg]
              }
            branch 1:
              region @s0 {
                args: [arg0, arg1, arg2, %cs, %os]
                n26 = Const(0x2) [] -> [?]
                n27 @s1 = Const(0x7) [] -> [?]
                n28 @s1 = Const(0x1) [] -> [?]
                n29 @s1 = Const(0xe) [] -> [?]
                n30 @s1 = Shl [arg2, n29.0] -> [?]
                n31 @s1 = Or [arg1, n30.0] -> [?]
                n32 @s1 = Const(0x3) [] -> [?]
                results: [n32.0, n31.0, arg2, %cs:arg, %os:arg]
              }
          } -> [?, ?, ?, %cs, %os]
          results: [n33.0, n33.1, n33.2, %cs:n33, %os:n33]
        }
    } -> [?, ?, ?, %cs, %os]
    n12 = WriteToField(offset=0, W4) [n34.1, %os:n34] -> [%os]
    results: [%cs:n34, %os:n12]
  }
}
