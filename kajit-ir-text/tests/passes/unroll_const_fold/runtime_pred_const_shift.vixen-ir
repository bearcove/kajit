scopes {
  s0 = lambda_body(@0)
  s1 = theta_body parent s0
}
lambda @0 @s0 (shape: "u8") {
  region @s0 {
    args: [%ms]
    n0 = Const(0x0) [] -> [v0]
    n1 = Const(0x0) [] -> [v1]
    n3 = Const(0x1) [] -> [v2]
    n4 = theta(max=3) [v0, v1, v2, %ms:arg] {
      region @s1 {
        args: [arg0, arg1, arg2, %ms]
        n5 = Const(0x7) [] -> [v3]
        n6 = Const(0x1) [] -> [v4]
        n7 = Mul [arg0, v3] -> [v5]
        n8 = Shl [arg2, v5] -> [v6]
        n9 = Or [arg1, v6] -> [v7]
        n10 = Add [arg0, v4] -> [v8]
        results: [arg2, v8, v7, arg2, %ms:arg]
      }
    } -> [v9, v10, v11, %ms]
    n11 = WriteToField(offset=0, W4) [v10, %ms:n4] -> [%ms]
    results: [%ms:n11]
  }
}
