lambda @0 (shape: "test") {
  region {
    args: [%cs, %os]
    n0 = Const(0x2a) [] -> [v0]
    n1 = WriteToSlot(0) [v0, %cs:arg] -> [%cs]
    n2 = Const(0x0) [] -> [v1]
    n9 = gamma [
      pred: v1
      in0: %cs:n1
      in1: %os:arg
    ] {
      branch 0:
        region {
          args: [%cs, %os]
          n3 = Const(0x1) [] -> [v2]
          n8 = gamma [
            pred: v2
            in0: %cs:arg
            in1: %os:arg
          ] {
            branch 0:
              region {
                args: [%cs, %os]
                n4 = ReadFromSlot(0) [%cs:arg] -> [v3, %cs]
                n5 = WriteToField(offset=0, W4) [v3, %os:arg] -> [%os]
                results: [%cs:n4, %os:n5]
              }
            branch 1:
              region {
                args: [%cs, %os]
                n6 = ReadFromSlot(0) [%cs:arg] -> [v4, %cs]
                n7 = WriteToField(offset=0, W4) [v4, %os:arg] -> [%os]
                results: [%cs:n6, %os:n7]
              }
          } -> [%cs, %os]
          results: [%cs:n8, %os:n8]
        }
      branch 1:
        region {
          args: [%cs, %os]
          results: [%cs:arg, %os:arg]
        }
    } -> [%cs, %os]
    results: [%cs:n9, %os:n9]
  }
}
